    {
      "name": "02 - Cadastro, login e autorizacao",
      "item": [
        {
          "name": "06 - Registrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Executar com a API iniciada via npm start. Confirme o status em Test Results.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Apresentacao\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Senha@123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"customerEmail\", \"cliente.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cadastro publico nao vira admin\", () => pm.expect(pm.response.json().user.role).to.eql(\"customer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Login como cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Executar com a API iniciada via npm start. Confirme o status em Test Results.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "if (response.token) pm.collectionVariables.set(\"customerToken\", response.token);",
                  "pm.test(\"Token de cliente recebido\", () => pm.expect(response.token).to.be.a(\"string\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
