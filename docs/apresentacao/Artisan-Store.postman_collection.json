      "name": "01 - Servidor e catalogo",
      "item": [
        {
          "name": "01 - Health: servidor online",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Executar com a API iniciada via npm start. Confirme o status em Test Results.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status da API ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Categorias: guardar ID Casa",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories",
            "description": "Executar com a API iniciada via npm start. Confirme o status em Test Results.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const categories = pm.response.json();",
                  "pm.test(\"Categorias retornadas\", () => pm.expect(categories).to.be.an(\"array\").that.is.not.empty);",
                  "const casa = categories.find(c => c.name === \"Casa\");",
                  "if (casa) pm.collectionVariables.set(\"categoryId\", String(casa.id));"
                ]
              }
            }
          ]
        },
