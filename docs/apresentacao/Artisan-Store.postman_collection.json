                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Executar com a API iniciada via npm start. Confirme o status em Test Results.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cesto Artesanal para Apresentacao\",\n  \"description\": \"Produto criado ao vivo durante a demonstracao do Postman.\",\n  \"price\": 69.9,\n  \"stock\": 12,\n  \"featured\": true,\n  \"categoryId\": {{categoryId}},\n  \"situationId\": {{situationId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
